APP_ENV=dev
BACKEND_API_KEY=change-me
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=["http://localhost:3100"]

MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=stocks
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8100/auth/kite/callback

TOKEN_ENCRYPTION_KEY=

LLM_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=
XAI_API_KEY=
# Any LiteLLM provider works: set LLM_MODEL (e.g. github/gpt-4o-mini, anthropic/claude-sonnet-5-5,
# openrouter/..., groq/...) and either LLM_API_KEY or <PROVIDER>_API_KEY (e.g. GITHUB_API_KEY).
LLM_API_KEY=

TRADING_MODE=paper
